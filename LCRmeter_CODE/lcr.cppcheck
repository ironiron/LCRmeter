<?xml version="1.0" encoding="UTF-8"?>
<project version="1">
    <builddir>lcr-cppcheck-build-dir</builddir>
    <platform>arm32-wchar_t2.xml</platform>
    <analyze-all-vs-configs>false</analyze-all-vs-configs>
    <check-headers>true</check-headers>
    <check-unused-templates>true</check-unused-templates>
    <inline-suppression>true</inline-suppression>
    <max-ctu-depth>2</max-ctu-depth>
    <max-template-recursion>100</max-template-recursion>
    <includedir>
        <dir name="Core/Inc/"/>
        <dir name="Hardware/Inc/"/>
        <dir name="libs/"/>
    </includedir>
    <paths>
        <dir name="Core/Src"/>
        <dir name="Hardware/Src"/>
        <dir name="libs"/>
    </paths>
    <exclude>
        <path name="tests/main_test.cpp"/>
        <path name="tests/catch.hpp"/>
        <path name="tests/fakeit.hpp"/>
        <path name="D:/Projekty/reszta/LCRmeter/LCRmeter_CODE/Core/Src/stm32g4xx_hal_msp.c"/>
        <path name="D:/Projekty/reszta/LCRmeter/LCRmeter_CODE/Core/Src/syscalls.c"/>
    </exclude>
    <libraries>
        <library>cppcheck-lib</library>
    </libraries>
    <suppressions>
        <suppression>missingIncludeSystem</suppression>
        <suppression>missingInclude</suppression>
        <suppression>unusedFunction</suppression>
        <suppression>invalidPrintfArgType_sint</suppression>
    </suppressions>
    <safe-checks>
        <class-public/>
    </safe-checks>
    <tags>
        <tag>missingInclude</tag>
    </tags>
    <check-level-exhaustive/>
    <project-name>lcr</project-name>
</project>
